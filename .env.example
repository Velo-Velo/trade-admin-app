# Copy to .env for local development. Never commit .env.

# Postgres connection string. Render fills this in from the blueprint database.
DATABASE_URL=postgresql://quotestick:quotestick@127.0.0.1:5432/quotestick

# Signs session cookies. Use a long random string in production.
# Render can generate this (generateValue: true in render.yaml).
SESSION_SECRET=replace-with-a-long-random-string

# Public URL of this app, with no trailing slash. Used in emails and quote links.
# On Render this is set from RENDER_EXTERNAL_URL. Locally:
APP_URL=http://localhost:3000

# Optional. When empty, quote drafts use trade templates only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. When empty, the customer quote page explains that card payments are not set up.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. When SMTP_HOST is empty, emails are printed in the server log and not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=quotes@example.com

# Protects POST/GET /api/cron/reminders. The Render cron job runs scripts/reminders.ts directly.
CRON_SECRET=

# Optional shared secret for a future Splitstick receipt feed.
# POST /api/integrations/splitstick with Authorization: Bearer <this secret>.
# When empty, that endpoint responds 501 and does nothing.
SPLITSTICK_WEBHOOK_SECRET=

# When true, the sign-in page shows magic links instead of only logging them.
# Leave false in production.
SHOW_DEV_LINKS=true
