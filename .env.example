# Copy to .env for local development. Never commit .env.

# Postgres connection string. Render fills this in from the blueprint database.
DATABASE_URL=postgresql://quotestick:quotestick@127.0.0.1:5432/quotestick

# Signs session cookies. Use a long random string in production.
# Render can generate this (generateValue: true in render.yaml).
SESSION_SECRET=replace-with-a-long-random-string

# Public URL of this app, with no trailing slash. Used in emails and quote links.
# On Render this is set from RENDER_EXTERNAL_URL. Locally:
APP_URL=http://localhost:3000

# Optional. Draft quote wording, voice-note transcripts, and reading receipt photos.
# When empty, quotes use templates, voice notes ask you to type, and a receipt photo is stored for you to fill in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe test keys first (sk_test_...). Leave empty to hide card buttons.
# Connect itself is switched on in the Stripe dashboard (Express, United Kingdom).
# Express onboarding uses this secret key. There is no separate Connect client id to paste here.
STRIPE_SECRET_KEY=
# Signing secret for the "Your account" event destination (plan payments).
STRIPE_WEBHOOK_SECRET=
# Optional. Signing secret for the "Connected accounts" destination.
# Use the same URL, /api/stripe/webhook. Deposit and invoice payments need this.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional. Signing secret for the thin-event destination that reports Accounts v2 updates.
# Same URL. Events from "Your account", payload style Thin. Without it, Connect status
# still refreshes when the trader returns from Stripe.
STRIPE_V2_ACCOUNT_WEBHOOK_SECRET=
# Recurring GBP prices in Stripe test mode. Subscriptions stay off until the test
# secret and both current price ids are set. A live secret does not start a subscription.
# Solo is £14 a month. Pro is £24 a month. VAT on these prices is not decided here.
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRO=
# Previous prices. Leave them set while anyone is still billed on them.
# STRIPE_PRICE_TRADE (£11.99) maps that subscription to Solo, without the new monthly caps.
# STRIPE_PRICE_SPLITSTICK (£16.99) maps that subscription to Pro.
# They are not offered as new checkouts.
STRIPE_PRICE_TRADE=
STRIPE_PRICE_SPLITSTICK=
# Optional platform fee in basis points. 0 means the trader receives the full card payment.
STRIPE_PLATFORM_FEE_BPS=0
# Optional. If set, server and page errors are POSTed here as JSON. Leave empty to only log them.
ERROR_WEBHOOK_URL=

# Optional. When SMTP_HOST is empty, emails are printed in the server log and not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=quotes@example.com

# Protects POST/GET /api/cron/reminders. The Render cron job runs scripts/reminders.ts directly.
CRON_SECRET=

# Optional shared secret for a future Splitstick receipt feed.
# POST /api/integrations/splitstick with Authorization: Bearer <this secret>.
# When empty, that endpoint responds 501 and does nothing.
SPLITSTICK_WEBHOOK_SECRET=

# When true, the sign-in page shows magic links instead of only logging them.
# Leave false in production.
SHOW_DEV_LINKS=true

# When true, the home page and sign-in page show "Try the demo".
# `npm start` then creates or resets the sample trader after migrations.
# Any other value leaves that account unchanged.
# Leave false on a site real traders use. Anyone who can open the site can enter the sample account.
DEMO_MODE=false

# Meta WhatsApp Business Cloud API. Leave all four empty and Receipts shows "WhatsApp is not connected".
# The app still starts. You can add a receipt photo in the app. Nothing is sent to Meta.
# WHATSAPP_TOKEN is a system-user token. WHATSAPP_PHONE_NUMBER_ID is the phone number id, not the phone number.
# WHATSAPP_VERIFY_TOKEN is a string you choose and enter in the Meta webhook screen.
# WHATSAPP_APP_SECRET is the app secret from App settings, used to check webhook signatures.
# There is no separate key for receipt photos. The same four values receive them.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional private file store for company documents (insurance PDFs, cards, training).
# Leave all four empty to keep files in Postgres. That is what demo mode and local development use.
# For Cloudflare R2: create a bucket, create an API token with object read and write, then set:
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_BUCKET=the-bucket-name
# S3_ACCESS_KEY_ID=the-token-access-key
# S3_SECRET_ACCESS_KEY=the-token-secret
# S3_REGION=auto
# Do not make the bucket public. Quotestick only serves a file to the signed-in trader.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
