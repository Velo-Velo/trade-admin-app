generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Trade {
  PLUMBING_HEATING
  ELECTRICAL
  BUILDING
  GENERAL
}

enum LineKind {
  LABOUR
  MATERIAL
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  LOST
  EXPIRED
}

enum ChaseKind {
  QUOTE
  SERVICE
}

enum ChaseStatus {
  PENDING
  SENT
  DISMISSED
}

enum ChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  NOT_APPLICABLE
}

enum PriceSource {
  MANUAL
  SPLITSTICK
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

enum JobStatus {
  BOOKED
  IN_PROGRESS
  DONE
}

enum JobPhotoKind {
  BEFORE
  AFTER
}

enum PlanTier {
  FREE
  SOLO
  PRO
}

enum MagicPurpose {
  SIGN_IN
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  trader          Trader?
  sessions        Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MagicLink {
  id        String       @id @default(cuid())
  email     String
  tokenHash String       @unique
  purpose   MagicPurpose @default(SIGN_IN)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([email])
}

model Trader {
  id           String   @id @default(cuid())
  userId       String   @unique
  businessName String
  slug         String   @unique
  trade        Trade
  area         String
  postcodes    String
  phone        String
  logoText     String
  brandColour  String
  services     String
  bio                   String   @default("")
  quoteSeq              Int      @default(0)
  invoiceSeq            Int      @default(0)
  whatsappE164          String?  @unique
  whatsappLinkCodeHash  String?
  whatsappLinkExpiresAt DateTime?
  whatsappVerifiedAt    DateTime?
  bankAccountName       String   @default("")
  bankSortCode          String   @default("")
  bankAccountNumber     String   @default("")
  tradingAddress        String   @default("")
  vatRegistered         Boolean  @default(false)
  vatNumber             String   @default("")
  googleReviewUrl       String   @default("")
  reviewChasersEnabled  Boolean  @default(true)
  quoteChasersEnabled   Boolean  @default(true)
  quoteChaseDays        Int      @default(3)
  quoteChaseSecondNudge Boolean  @default(true)
  quoteChaseSecondDays  Int      @default(7)
  quoteValidDays        Int      @default(30)
  autoSendQuoteChasers  Boolean  @default(false)
  serviceRemindWeeks    Int      @default(4)
  siteTheme               String   @default("yard")
  ramsSeq                 Int      @default(0)
  plan                    PlanTier @default(FREE)
  /// Trade subscribers moved to Solo keep the old unlimited allowance.
  legacyUnlimited         Boolean  @default(false)
  stripeAccountId         String?  @unique
  stripeChargesEnabled    Boolean  @default(false)
  stripeDetailsSubmitted  Boolean  @default(false)
  stripePayoutsEnabled    Boolean  @default(false)
  stripeCustomerId        String?  @unique
  /// Platform Billing subscription. Not the Connect account used for deposits.
  stripeSubscriptionId    String?  @unique
  subscriptionStatus      String   @default("")
  subscriptionPriceId     String   @default("")
  createdAt               DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enquiries             Enquiry[]
  quotes                Quote[]
  invoices              Invoice[]
  customers             Customer[]
  jobs                  Job[]
  priceItems            PriceBookItem[]
  checklist             ChecklistItem[]
  whatsappMessages      WhatsAppMessage[]
  expenses              Expense[]
  chases                CustomerChase[]
  serviceReminders      ServiceReminder[]
  companyDocuments      CompanyDocument[]
  rams                  Rams[]
}

model Enquiry {
  id             String         @id @default(cuid())
  traderId       String
  customerName   String
  contact        String
  postcode       String
  jobDescription String
  source         String         @default("website")
  customerId     String?
  createdAt      DateTime       @default(now())
  trader         Trader         @relation(fields: [traderId], references: [id], onDelete: Cascade)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  photos         EnquiryPhoto[]
  quote          Quote?

  @@index([traderId, createdAt])
  @@index([customerId])
}

model EnquiryPhoto {
  id        String   @id @default(cuid())
  enquiryId String
  filename  String
  mimeType  String
  bytes     Bytes
  createdAt DateTime @default(now())
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
}

model JobTemplate {
  id       String            @id @default(cuid())
  trade    Trade
  slug     String            @unique
  name     String
  summary  String
  keywords String
  lines    JobTemplateLine[]
}

model JobTemplateLine {
  id                String      @id @default(cuid())
  templateId        String
  kind              LineKind
  description       String
  quantity          Decimal     @db.Decimal(10, 2)
  unit              String
  starterPricePence Int
  sortOrder         Int
  template          JobTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model PriceBookItem {
  id                  String      @id @default(cuid())
  traderId            String
  kind                LineKind
  description         String
  unit                String
  sellPricePence      Int
  lastPaidPence       Int?
  lastPaidAt          DateTime?
  source              PriceSource @default(MANUAL)
  splitstickReceiptId String?
  merchant            String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  trader              Trader      @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@index([traderId])
  @@index([splitstickReceiptId])
}

model Quote {
  id              String      @id @default(cuid())
  traderId        String
  enquiryId       String?     @unique
  number          String
  status          QuoteStatus @default(DRAFT)
  customerName    String
  customerContact String
  postcode        String
  jobDescription  String
  publicToken     String      @unique
  domestic        Boolean     @default(true)
  depositPercent  Int         @default(30)
  coolingOffText  String      @default("")
  draftNote       String      @default("")
  approvedAt      DateTime?
  sentAt          DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  depositPaidAt       DateTime?
  stripeSessionId     String?
  stripePaymentLinkId String?
  stripePaymentUrl    String?
  reviewToken         String?     @unique
  reviewChaserEnabled Boolean     @default(true)
  reviewStage         Int         @default(0)
  lastReviewAt        DateTime?
  reviewClickedAt     DateTime?
  jobCompletedAt      DateTime?
  chaseStage          Int         @default(0)
  chaseEnabled        Boolean     @default(true)
  lastChasedAt        DateTime?
  lostAt              DateTime?
  expiresAt           DateTime?
  expiredAt           DateTime?
  customerId          String?
  createdAt           DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  trader          Trader      @relation(fields: [traderId], references: [id], onDelete: Cascade)
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  enquiry         Enquiry?    @relation(fields: [enquiryId], references: [id])
  lines           QuoteLine[]
  events          QuoteEvent[]
  job             Job?
  chases          CustomerChase[]

  @@unique([traderId, number])
  @@index([traderId, status])
  @@index([stripePaymentLinkId])
  @@index([customerId])
  @@index([expiresAt])
}

model QuoteLine {
  id              String   @id @default(cuid())
  quoteId         String
  kind            LineKind
  description     String
  quantity        Decimal  @db.Decimal(10, 2)
  unit            String
  unitPricePence  Int
  priceBookItemId String?
  lastPaidPence   Int?
  sortOrder       Int
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model QuoteEvent {
  id        String   @id @default(cuid())
  quoteId   String
  type      String
  channel   String
  detail    String   @default("")
  createdAt DateTime @default(now())
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model ChecklistItem {
  id              String          @id @default(cuid())
  traderId        String
  key             String
  title           String
  detail          String
  officialUrl     String
  verifyUrl       String
  badgeLabel      String          @default("")
  publicRegister  Boolean         @default(false)
  status          ChecklistStatus @default(NOT_STARTED)
  referenceNumber String          @default("")
  expiresAt       DateTime?
  showOnWebsite   Boolean         @default(false)
  reminderDays    Int             @default(30)
  lastRemindedAt  DateTime?
  sortOrder       Int
  trader          Trader          @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@unique([traderId, key])
  @@index([expiresAt])
}

model Invoice {
  id                  String        @id @default(cuid())
  traderId            String
  number              String
  status              InvoiceStatus @default(DRAFT)
  customerName        String
  customerContact     String        @default("")
  description         String
  netPence            Int
  vatPence            Int
  totalPence          Int
  vatRate             Int           @default(0)
  publicToken         String        @unique
  dueAt               DateTime
  chaserEnabled       Boolean       @default(true)
  chaserStage         Int           @default(0)
  lastChasedAt        DateTime?
  paidAt              DateTime?
  approvedAt          DateTime?
  sentAt              DateTime?
  stripePaymentLinkId String?
  stripePaymentUrl    String?
  businessName        String
  phone               String
  tradingAddress      String        @default("")
  vatNumber           String        @default("")
  bankAccountName     String        @default("")
  bankSortCode        String        @default("")
  bankAccountNumber   String        @default("")
  reviewToken         String        @unique
  reviewChaserEnabled Boolean       @default(true)
  reviewStage         Int           @default(0)
  lastReviewAt        DateTime?
  reviewClickedAt     DateTime?
  jobCompletedAt      DateTime?
  source              String        @default("dashboard")
  customerId          String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  trader              Trader        @relation(fields: [traderId], references: [id], onDelete: Cascade)
  customer            Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  events              InvoiceEvent[]
  job                 Job?

  @@unique([traderId, number])
  @@index([traderId, status])
  @@index([dueAt])
  @@index([stripePaymentLinkId])
  @@index([customerId])
}

model InvoiceEvent {
  id        String   @id @default(cuid())
  invoiceId String
  type      String
  channel   String
  detail    String   @default("")
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model WhatsAppMessage {
  id        String   @id @default(cuid())
  traderId  String?
  phone     String
  direction String
  body      String
  createdAt DateTime @default(now())
  trader    Trader?  @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@index([phone, createdAt])
  @@index([traderId, createdAt])
}

model WhatsAppReceipt {
  id        String   @id
  createdAt DateTime @default(now())
}

enum ExpenseStatus {
  NEEDS_REVIEW
  CONFIRMED
}

enum ExpenseCategory {
  MATERIALS
  FUEL
  TOOLS
  OTHER
}

/// A purchase the trader made (materials, fuel, tools). Figures are a record for them and their accountant.
/// Quotestick does not file this with HMRC.
model Expense {
  id             String          @id @default(cuid())
  traderId       String
  status         ExpenseStatus   @default(NEEDS_REVIEW)
  supplier       String          @default("")
  description    String          @default("")
  spentOn        DateTime?
  totalPence     Int?
  vatPence       Int?
  category       ExpenseCategory @default(OTHER)
  extractionNote String          @default("")
  imageFilename  String          @default("receipt.jpg")
  imageMime      String          @default("image/jpeg")
  imageBytes     Bytes
  source         String          @default("whatsapp")
  jobId          String?
  customerId     String?
  confirmedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  trader         Trader          @relation(fields: [traderId], references: [id], onDelete: Cascade)
  job            Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([traderId, createdAt])
  @@index([traderId, status])
  @@index([jobId])
  @@index([customerId])
}

model Customer {
  id         String    @id @default(cuid())
  traderId   String
  name       String
  phone      String    @default("")
  email      String    @default("")
  postcode   String    @default("")
  address    String    @default("")
  searchText String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  trader     Trader    @relation(fields: [traderId], references: [id], onDelete: Cascade)
  enquiries  Enquiry[]
  quotes     Quote[]
  invoices   Invoice[]
  jobs       Job[]
  rams       Rams[]
  expenses   Expense[]
  serviceReminders ServiceReminder[]

  @@index([traderId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Job {
  id         String    @id @default(cuid())
  traderId   String
  customerId String
  quoteId    String?   @unique
  invoiceId  String?   @unique
  title      String
  address    String    @default("")
  postcode   String    @default("")
  status     JobStatus @default(BOOKED)
  bookedAt   DateTime  @default(now())
  startedAt  DateTime?
  doneAt             DateTime?
  recurring          Boolean   @default(false)
  intervalMonths     Int       @default(12)
  serviceDueAt       DateTime?
  serviceChaseStage  Int       @default(0)
  lastServiceChasedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  trader     Trader    @relation(fields: [traderId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quote      Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  photos     JobPhoto[]
  chases     CustomerChase[]
  rams       Rams[]
  expenses   Expense[]
  serviceReminders ServiceReminder[]

  @@index([traderId, status])
  @@index([customerId])
  @@index([serviceDueAt])
}

model CustomerChase {
  id        String      @id @default(cuid())
  traderId  String
  kind      ChaseKind
  status    ChaseStatus @default(PENDING)
  quoteId   String?
  jobId     String?
  serviceReminderId String?
  stage     Int
  subject   String
  body      String
  createdAt DateTime    @default(now())
  sentAt    DateTime?
  trader    Trader      @relation(fields: [traderId], references: [id], onDelete: Cascade)
  quote     Quote?      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  job       Job?        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  serviceReminder ServiceReminder? @relation(fields: [serviceReminderId], references: [id], onDelete: Cascade)

  @@unique([quoteId, stage])
  @@unique([jobId, stage])
  @@unique([serviceReminderId, stage])
  @@index([traderId, status])
}

model ServiceReminder {
  id             String    @id @default(cuid())
  traderId       String
  customerId     String
  jobId          String?
  title          String
  intervalMonths Int       @default(12)
  dueAt          DateTime
  enabled        Boolean   @default(true)
  chaseStage     Int       @default(0)
  lastChasedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  trader         Trader    @relation(fields: [traderId], references: [id], onDelete: Cascade)
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job            Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  chases         CustomerChase[]

  @@index([traderId, dueAt])
  @@index([customerId])
}

/// Evidence kept once so a later accreditation pack can reuse it.
/// This build does not fill CHAS, SafeContractor, SMAS or Constructionline forms.
enum CompanyDocumentKind {
  PUBLIC_LIABILITY
  EMPLOYERS_LIABILITY
  TRADE_CARD
  TRAINING
  SAFETY_POLICY
  OTHER
}

enum RamsTrade {
  PLUMBING_HEATING
  ELECTRICAL
  ROOFING
  CARPENTRY_JOINERY
  DECORATING
  GROUNDWORKS_LANDSCAPING
  GENERAL_BUILDING
}

enum RamsStatus {
  DRAFT
  ISSUED
  AWAITING_SIGNATURES
  SIGNED
}

enum RamsSignerKind {
  APPROVER
  OPERATIVE
}

model CompanyDocument {
  id              String              @id @default(cuid())
  traderId        String
  kind            CompanyDocumentKind
  title           String
  issuer          String              @default("")
  referenceNumber String              @default("")
  issuedOn        DateTime?
  expiresOn       DateTime?
  notes           String              @default("")
  fileName        String              @default("")
  fileMime        String              @default("")
  fileBytes       Bytes?
  storageKey      String              @default("")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  trader          Trader              @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@index([traderId, kind])
  @@index([expiresOn])
}

model Rams {
  id              String     @id @default(cuid())
  traderId        String
  jobId           String?
  customerId      String?
  number          String
  title           String
  status          RamsStatus @default(DRAFT)
  trade           RamsTrade
  isTemplate      Boolean    @default(false)
  siteAddress     String     @default("")
  sitePostcode    String     @default("")
  clientName      String     @default("")
  clientRole      String     @default("Client")
  startOn         DateTime?
  finishOn        DateTime?
  scopeOfWork     String     @default("")
  competentName   String     @default("")
  competentRole   String     @default("")
  competentPhone  String     @default("")
  signedName      String     @default("")
  signedOn        DateTime?
  nearestHospital String     @default("")
  emergencyNotes  String     @default("")
  firstAidNotes   String     @default("")
  welfareNotes    String     @default("")
  ppe             String     @default("")
  contentVersion  Int        @default(1)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  trader          Trader     @relation(fields: [traderId], references: [id], onDelete: Cascade)
  job             Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  customer        Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  hazards         RamsHazard[]
  steps           RamsStep[]
  substances      RamsSubstance[]
  permits         RamsPermit[]
  briefings       RamsBriefing[]
  signers         RamsSigner[]
  signatures      RamsSignature[]

  @@unique([traderId, number])
  @@index([traderId, updatedAt])
  @@index([jobId])
  @@index([customerId])
  @@index([traderId, isTemplate])
}

model RamsHazard {
  id                 String @id @default(cuid())
  ramsId             String
  sortOrder          Int
  libraryKey         String @default("")
  activity           String @default("")
  hazard             String
  whoHarmed          String @default("")
  likelihoodBefore   Int
  severityBefore     Int
  controls           String
  likelihoodAfter    Int
  severityAfter      Int
  rams               Rams   @relation(fields: [ramsId], references: [id], onDelete: Cascade)

  @@index([ramsId])
}

model RamsStep {
  id        String @id @default(cuid())
  ramsId    String
  sortOrder Int
  detail    String
  rams      Rams   @relation(fields: [ramsId], references: [id], onDelete: Cascade)

  @@index([ramsId])
}

model RamsSubstance {
  id        String @id @default(cuid())
  ramsId    String
  sortOrder Int
  name      String
  hazard    String @default("")
  controls  String @default("")
  rams      Rams   @relation(fields: [ramsId], references: [id], onDelete: Cascade)

  @@index([ramsId])
}

model RamsPermit {
  id        String  @id @default(cuid())
  ramsId    String
  sortOrder Int
  name      String
  required  Boolean @default(false)
  detail    String  @default("")
  rams      Rams    @relation(fields: [ramsId], references: [id], onDelete: Cascade)

  @@index([ramsId])
}

model RamsBriefing {
  id            String    @id @default(cuid())
  ramsId        String
  sortOrder     Int
  operativeName String
  role          String    @default("")
  phone         String    @default("")
  briefedOn     DateTime?
  signatureName String    @default("")
  rams          Rams      @relation(fields: [ramsId], references: [id], onDelete: Cascade)

  @@index([ramsId])
}

model RamsSigner {
  id         String          @id @default(cuid())
  ramsId     String
  kind       RamsSignerKind
  name       String
  roleLabel  String          @default("")
  phone      String          @default("")
  token      String          @unique
  createdAt  DateTime        @default(now())
  rams       Rams            @relation(fields: [ramsId], references: [id], onDelete: Cascade)
  signatures RamsSignature[]

  @@index([ramsId, kind])
}

model RamsSignature {
  id             String         @id @default(cuid())
  ramsId         String
  signerId       String?
  kind           RamsSignerKind
  name           String
  roleLabel      String         @default("")
  image          Bytes
  signedAt       DateTime       @default(now())
  contentVersion Int
  invalidatedAt  DateTime?
  invalidReason  String         @default("")
  rams           Rams           @relation(fields: [ramsId], references: [id], onDelete: Cascade)
  signer         RamsSigner?    @relation(fields: [signerId], references: [id], onDelete: SetNull)

  @@index([ramsId, contentVersion])
  @@index([signerId])
}

model JobPhoto {
  id        String       @id @default(cuid())
  jobId     String
  kind      JobPhotoKind
  filename  String
  mimeType      String
  bytes         Bytes
  showOnWebsite Boolean  @default(false)
  createdAt     DateTime @default(now())
  job       Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
